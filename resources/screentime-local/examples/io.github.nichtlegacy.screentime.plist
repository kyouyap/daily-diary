<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>io.github.nichtlegacy.screentime</string>
<key>ProgramArguments</key><array>
<string>__HOME__/.local/share/screentime-local/app/bin/python</string>
<string>-I</string><string>-B</string>
<string>__HOME__/.local/share/screentime-local/collector/local_screentime.py</string>
<string>collect</string>
</array>
<key>StartInterval</key><integer>900</integer>
<key>RunAtLoad</key><true/>
<key>EnvironmentVariables</key><dict><key>TZ</key><string>Asia/Tokyo</string></dict>
<key>Umask</key><integer>63</integer>
<key>StandardOutPath</key><string>__HOME__/Library/Logs/screentime/stdout.log</string>
<key>StandardErrorPath</key><string>__HOME__/Library/Logs/screentime/stderr.log</string>
</dict></plist>
